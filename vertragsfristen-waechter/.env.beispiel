# Kopie als .env anlegen und anpassen. Ohne diese Datei laufen die Vorgaben.

# Server
PORT=4000
HOST=127.0.0.1
DATENBANK=daten/waechter.sqlite

# Adresse, unter der die Oberfläche erreichbar ist. Landet in Erinnerungsmails
# und im Kalender-Abonnement.
BASIS_ADRESSE=http://localhost:5173

# Mailversand. Ohne SMTP_URL bleiben Erinnerungen im Postausgang liegen und
# sind dort in der Oberfläche einsehbar.
# SMTP_URL=smtps://benutzer:kennwort@mail.example.de:465
ABSENDER=Vertragsfristen-Wächter <waechter@example.de>

# Wie oft der Fristenlauf nach fälligen Erinnerungen sieht.
PLANER_TAKT_MINUTEN=60
SITZUNGSDAUER_TAGE=30
