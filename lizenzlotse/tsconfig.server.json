{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true,
    "types": ["node"],
    "noEmit": false,
    "outDir": "bau/server",
    "rootDir": "src",
    "sourceMap": true
  },
  "include": ["src/server", "src/fachlogik"],
  "exclude": ["**/*.test.ts"]
}
