; NEKTON - Godot Projektkonfiguration
config_version=5

[application]

config/name="Nekton"
config/description="Deep Guard: a cone of light on your fingertip, a dark trench, and everything in it coming at you."
config/version="1.0.0"
; **Der Titelbildschirm ist der Eingang.** Vorher startete die App direkt in
; der Schlundwache; auf einem Telefon gibt es keine Kommandozeile, also war
; der Rundumlauf dort ueberhaupt nicht erreichbar. Jetzt fuehrt das Menue in
; beide - und `--schlund` springt fuer die Werkzeuge direkt in die alte Szene,
; so wie `--rundum` vorher andersherum.
;
; **Kommentare hier fangen mit Strichpunkt an.** Mit `#` gesetzt zerreisst es
; die Sektion, und Godot meldet "no main scene defined" - was wie ein
; fehlender Eintrag aussieht und keiner ist.
run/main_scene="res://scenes/rundum.tscn"
; **Die Zurueck-Taste beendet nicht die App.**
;
; Godots Voreinstellung ist, bei Zurueck sofort zu beenden - auf Android also
; mitten in der Welle, mit einem Tastendruck, den jeder aus Versehen macht.
; `wache.gd` faengt die Meldung jetzt ab: offener Koloniebildschirm schliesst
; sich, sonst haelt das Spiel an. Eine Ebene zurueck, so wie ueberall sonst.
run/flush_stdout_on_print=true
config/quit_on_go_back=false
config/icon="res://symbol.png"
config/features=PackedStringArray("4.5", "GL Compatibility")

[autoload]

Fortschritt="*res://scripts/autoload/fortschritt.gd"
Klang="*res://scripts/spiel/klang.gd"
Tastsinn="*res://scripts/spiel/tastsinn.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

; **Hohe Bildwiederholrate ist erlaubt und nicht gedeckelt.**
;
; Godots Voreinstellung waere vsync an und kein eigener Deckel - genau das
; steht hier jetzt ausdruecklich, damit es niemand versehentlich aendert.
; Auf einem 120-Hz-Telefon zeigt das Spiel damit 120 Bilder je Sekunde, auf
; einem 60-Hz-Telefon sechzig.
;
; **Das ist nur deshalb ungefaehrlich, weil alles mit `delta` rechnet.** Bis
; kurz vor dieser Zeile tat es das nicht ueberall: im Rundumlauf wurde die
; Wirkung einer ganzen Sekunde als Schaden eines *Bildes* abgezogen. Bei
; doppelter Bildrate waere der Kegel doppelt so stark gewesen - eine
; Einstellung im Anzeigemenue haette den Schwierigkeitsgrad verstellt.
;
; Der Spieler kann trotzdem deckeln: `KolonieStand.bildrate` (0 = frei, 60,
; 120), im Koloniebildschirm unter DAY. Ein 120-Hz-Bild kostet Akku, und wer
; das nicht will, soll es abstellen koennen, ohne das Spiel zu aendern.
window/vsync/vsync_mode=1

; Swappy: Androids Taktgeber fuer gleichmaessige Bilder. Er ist es auch, der
; die hohe Rate ueberhaupt anfordert - ohne ihn bleiben viele Geraete bei
; sechzig, obwohl der Schirm mehr kann.
window/frame_pacing/android/enable_frame_pacing=true
window/frame_pacing/android/swappy_mode=2

[rendering]

; **Hier stand einmal `anti_aliasing/quality/msaa_2d=2`, und das war
; wirkungslos.** Godot meldet dazu beim Start: "2D MSAA is not yet supported
; for GLES3" - der Kompatibilitaets-Renderer kann es schlicht nicht, und
; genau den benutzt dieses Projekt, weil er im Browser und auf alten Geraeten
; laeuft. Die Einstellung hat also nichts geglaettet und dafuer bei jedem
; Start gewarnt.
;
; Weiche Kanten kommen hier deshalb aus dem Zeichnen selbst: `draw_polyline`
; mit `antialiased`, und in `schwarm.gd::_koerper()` liegt ueber jeder
; Fuellkante ein breiter, halbdurchsichtiger Strich derselben Farbe. Das ist
; der Grund, warum die Umrisse trotzdem weich sind.

textures/vram_compression/import_etc2_astc=true

; **Gluehen braucht einen HDR-Puffer.** Ohne ihn wird alles ueber 1.0 vorher
; abgeschnitten, und die Schwelle des Leuchtens hat nichts mehr, woran sie
; greifen kann - das Bild sieht dann aus wie vorher, nur weicher.
viewport/hdr_2d=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.012, 0.024, 0.043, 1)
