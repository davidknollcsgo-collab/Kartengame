; HUNDRED CUTS - Godot Projektkonfiguration
config_version=5

[application]

config/name="Ten Thousand"
config/description="One against ten thousand. Your blade swings itself; you choose where to stand and what to become."
; **Kommentare hier fangen mit Strichpunkt an.** Mit `#` gesetzt zerreisst es
; die Sektion, und Godot meldet "no main scene defined" - was wie ein
; fehlender Eintrag aussieht und keiner ist.
config/version="1.0.0"
run/main_scene="res://scenes/gefecht.tscn"
; Die Zurueck-Taste beendet nicht die App.
run/flush_stdout_on_print=true
config/quit_on_go_back=false
config/icon="res://symbol.png"
config/features=PackedStringArray("4.5", "GL Compatibility")

[autoload]

Burg="*res://scripts/autoload/burg.gd"
Klang="*res://scripts/spiel/klang.gd"
Tastsinn="*res://scripts/spiel/tastsinn.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

; **Hohe Bildwiederholrate ist erlaubt und nicht gedeckelt.**
;
; Godots Voreinstellung waere vsync an und kein eigener Deckel - genau das
; steht hier jetzt ausdruecklich, damit es niemand versehentlich aendert.
; Auf einem 120-Hz-Telefon zeigt das Spiel damit 120 Bilder je Sekunde, auf
; einem 60-Hz-Telefon sechzig.
;
; **Das ist nur deshalb ungefaehrlich, weil alles mit `delta` rechnet.** Bis
; kurz vor dieser Zeile tat es das nicht ueberall: im Rundumlauf wurde die
; Wirkung einer ganzen Sekunde als Schaden eines *Bildes* abgezogen. Bei
; doppelter Bildrate waere der Kegel doppelt so stark gewesen - eine
; Einstellung im Anzeigemenue haette den Schwierigkeitsgrad verstellt.
;
; Der Spieler kann trotzdem deckeln: `KolonieStand.bildrate` (0 = frei, 60,
; 120), im Koloniebildschirm unter DAY. Ein 120-Hz-Bild kostet Akku, und wer
; das nicht will, soll es abstellen koennen, ohne das Spiel zu aendern.
window/vsync/vsync_mode=1

; Swappy: Androids Taktgeber fuer gleichmaessige Bilder. Er ist es auch, der
; die hohe Rate ueberhaupt anfordert - ohne ihn bleiben viele Geraete bei
; sechzig, obwohl der Schirm mehr kann.
window/frame_pacing/android/enable_frame_pacing=true
window/frame_pacing/android/swappy_mode=2

[rendering]

; **Hier stand einmal `anti_aliasing/quality/msaa_2d=2`, und das war
; wirkungslos.** Godot meldet dazu beim Start: "2D MSAA is not yet supported
; for GLES3" - der Kompatibilitaets-Renderer kann es schlicht nicht, und
; genau den benutzt dieses Projekt, weil er im Browser und auf alten Geraeten
; laeuft. Die Einstellung hat also nichts geglaettet und dafuer bei jedem
; Start gewarnt.
;
; Weiche Kanten kommen hier aus dem Zeichnen selbst: `Tusche` legt jeden
; Strich als Dreiecksnetz mit zwei durchsichtigen Aussenreihen an. Das ist
; kein Glaettungstrick, sondern die Form eines Haarpinsels - die weiche Kante
; ist hier das Motiv und nicht ihre Behebung.

textures/vram_compression/import_etc2_astc=true

; **Kein HDR und kein Gluehen.** Ein Holzschnitt leuchtet nicht - er liegt auf
; Pergament, und ein Blueheffekt darauf sieht aus wie ein schlecht belichteter
; Scan. Der Puffer bleibt damit auch billiger, und das zaehlt hier doppelt:
; in Minute neun stehen hundert Figuren im Bild.
viewport/hdr_2d=false
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
; Pergament. Es ist kein Weiss und kein Grau: Pergament ist warm, und ohne
; diesen Ton sieht jede Tusche darauf aus, als waere sie ausgeschnitten.
environment/defaults/default_clear_color=Color(0.804, 0.776, 0.694, 1)
